<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.enterprise.mapper.PlanProgressMapper">

    <resultMap id="PlanProgressResultMap" type="com.company.enterprise.entity.PlanProgress">
        <id column="id" property="id"/>
        <result column="plan_id" property="planId"/>
        <result column="progress" property="progress"/>
        <result column="content" property="content"/>
        <result column="submitter_id" property="submitterId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <insert id="insertPlanProgress" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_plan_progress (
            plan_id, progress, content, submitter_id, create_time, update_time, is_deleted
        ) VALUES (
            #{planId}, #{progress}, #{content}, #{submitterId}, NOW(), NOW(), 0
        )
    </insert>

    <select id="selectByPlanId" resultMap="PlanProgressResultMap">
        SELECT id, plan_id, progress, content, submitter_id, create_time, update_time, is_deleted
        FROM t_plan_progress
        WHERE plan_id = #{planId}
          AND is_deleted = 0
        ORDER BY create_time DESC, id DESC
    </select>
</mapper>
