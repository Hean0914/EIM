<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.company.enterprise.mapper.AttendanceLocationMapper">

    <resultMap id="AttendanceLocationResultMap" type="com.company.enterprise.entity.AttendanceLocation">
        <id column="id" property="id"/>
        <result column="location_name" property="locationName"/>
        <result column="address" property="address"/>
        <result column="longitude" property="longitude"/>
        <result column="latitude" property="latitude"/>
        <result column="allowed_radius" property="allowedRadius"/>
        <result column="accuracy_limit" property="accuracyLimit"/>
        <result column="status" property="status"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <select id="selectCurrentLocation" resultMap="AttendanceLocationResultMap">
        SELECT id, location_name, address, longitude, latitude, allowed_radius, accuracy_limit,
               status, remark, create_time, update_time, is_deleted
        FROM t_attendance_location
        WHERE status = 1
          AND is_deleted = 0
        ORDER BY id ASC
        LIMIT 1
    </select>

    <update id="updateLocation">
        UPDATE t_attendance_location
        SET location_name = #{locationName},
            address = #{address},
            longitude = #{longitude},
            latitude = #{latitude},
            allowed_radius = #{allowedRadius},
            accuracy_limit = #{accuracyLimit},
            remark = #{remark},
            update_time = NOW()
        WHERE id = #{id}
          AND is_deleted = 0
    </update>
</mapper>
