# Spring datasource
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=enterprise_information
MYSQL_USERNAME=
MYSQL_PASSWORD=

# JWT signing
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Aliyun OSS. The SDK reads OSS_ACCESS_KEY_ID and OSS_ACCESS_KEY_SECRET
# from the process environment at upload time.
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=
OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Optional local AI/search services
OLLAMA_BASE_URL=http://localhost:11434
AI_WEB_SEARCH_ENABLED=false
AI_WEB_SEARCH_BASE_URL=http://localhost:8081
AI_WEB_SEARCH_TIMEOUT_MS=8000
AI_WEB_SEARCH_MAX_RESULTS=5
AI_WEB_SEARCH_MAX_SNIPPET_LENGTH=800
